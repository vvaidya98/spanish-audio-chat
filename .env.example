# Anthropic API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Server configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-netlify-domain.netlify.app

# Frontend-only (Vite): Formspree endpoint for the optional post-session email
# capture form. Create a form at formspree.io and paste its endpoint here.
# If unset, the email capture form simply doesn't render (no error).
VITE_FORMSPREE_URL=https://formspree.io/f/your-form-id
